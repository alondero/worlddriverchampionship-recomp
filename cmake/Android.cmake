# Native Android dependencies are fetched and pinned by scripts/build_android.py.
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(WDC_ANDROID_DEPS "${CMAKE_SOURCE_DIR}/build-android/deps" CACHE PATH "Android dependency sources")
if(EXISTS "${WDC_ANDROID_DEPS}/SDL/CMakeLists.txt")
    add_subdirectory("${WDC_ANDROID_DEPS}/SDL" "${CMAKE_BINARY_DIR}/SDL")
    set(SDL2_INCLUDE_DIRS "${WDC_ANDROID_DEPS}/SDL/include")
    set(SDL2_LIBRARIES SDL2::SDL2)
endif()
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake/android")
set(WDC_HOST_DXC "${CMAKE_COMMAND};-E;echo;WDC host DXC placeholder")
