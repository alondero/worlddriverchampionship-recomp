diff --git a/ultramodern/include/ultramodern/thread_snapshot.hpp b/ultramodern/include/ultramodern/thread_snapshot.hpp
new file mode 100644
index 0000000..0ba1614
--- /dev/null
+++ b/ultramodern/include/ultramodern/thread_snapshot.hpp
@@ -0,0 +1,55 @@
+#pragma once
+#include "ultra64.h"
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <mutex>
+
+namespace ultramodern {
+// Developer RAM snapshots cannot serialize native stacks. This registry only
+// removes native pointers on save and reconnects an equivalent live roster on
+// load. Call prepare on the running guest thread without yielding until the
+// caller has copied the prepared image. Native readers require separate care.
+class ThreadSnapshotRegistry {
+    std::mutex mutex;
+    std::map<uint32_t, UltraThreadContext*> contexts;
+public:
+    void add(uint32_t address, UltraThreadContext* context) {
+        std::lock_guard lock(mutex);
+        contexts[address] = context;
+    }
+    void remove(uint32_t address, UltraThreadContext* context) {
+        std::lock_guard lock(mutex);
+        auto it = contexts.find(address);
+        if (it != contexts.end() && it->second == context) contexts.erase(it);
+    }
+    bool prepare(uint8_t* rdram, uint8_t* image, uint32_t size,
+            uint32_t* addresses, uint32_t* count, bool restore) {
+        std::lock_guard lock(mutex);
+        if (!rdram || !image || !addresses || !count || contexts.empty() ||
+            (restore ? *count != contexts.size() : *count < contexts.size())) return false;
+        size_t index = 0;
+        // Validate everything before changing even the scratch image.
+        for (const auto& [address, context] : contexts) {
+            if (address < 0x80000000u || size < sizeof(OSThread) ||
+                address - 0x80000000u > size - sizeof(OSThread) || (address & 7)) return false;
+            const uint32_t offset = address - 0x80000000u;
+            const auto* live = reinterpret_cast<const OSThread*>(rdram + offset);
+            const auto* saved = reinterpret_cast<const OSThread*>(image + offset);
+            if (live->context != context || (restore && (addresses[index] != address ||
+                    saved->context != nullptr || saved->sp != live->sp ||
+                    std::memcmp(saved, live, offsetof(OSThread, context)) != 0))) return false;
+            ++index;
+        }
+        index = 0;
+        for (const auto& [address, context] : contexts) {
+            addresses[index++] = address;
+            auto* saved = reinterpret_cast<OSThread*>(image + address - 0x80000000u);
+            saved->context = restore ? context : nullptr;
+        }
+        *count = static_cast<uint32_t>(contexts.size());
+        return true;
+    }
+};
+}
