+    // Half of the RDP's quarter-pixel Y step. Upscaling exposes subpixel
+    // background slivers between separately rounded opaque surfaces. Do not
+    // expand alpha-tested, coverage-masked or blended layers (e.g. reflections).
+    inline double opaqueCoverageRadius(uint32_t otherMode) {
+        constexpr uint32_t required = 0x2008; // ALPHA_CVG_SEL | AA_EN
+        constexpr uint32_t excluded = 0x5003; // FORCE_BL | CVG_X_ALPHA | ALPHACOMPARE
+        return (otherMode & required) == required && !(otherMode & excluded) ? 0.125 : 0.0;
+    }
