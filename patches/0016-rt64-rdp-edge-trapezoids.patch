diff --git a/src/gbi/rt64_rdp_triangle_edges.h b/src/gbi/rt64_rdp_triangle_edges.h
new file mode 100644
index 0000000..3b0248a
--- /dev/null
+++ b/src/gbi/rt64_rdp_triangle_edges.h
@@ -0,0 +1,67 @@
+//
+// RT64
+//
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace RT64::GBI_RDP {
+    // Edge coefficients of a raw RDP triangle command, in framebuffer pixels.
+    // XH and XM are given at scanline floor(YH); XL is given at YM.
+    struct TriangleEdges {
+        bool leftMajor;
+        double yh, ym, yl;
+        double xh, xm, xl;
+        double dxhdy, dxmdy, dxldy;
+
+        double yFloor() const { return std::floor(yh); }
+        double majorX(double y) const { return xh + dxhdy * (y - yFloor()); }
+        double middleX(double y) const { return xm + dxmdy * (y - yFloor()); }
+        double lowX(double y) const { return xl + dxldy * (y - ym); }
+    };
+
+    inline TriangleEdges decodeTriangleEdges(const std::array<uint32_t, 8>& words) {
+        auto y = [](uint32_t v) { return double(int16_t(uint16_t(v << 2)) >> 2) / 4.0; };
+        auto x = [](uint32_t v) { return double(int32_t(v)) / 65536.0; };
+        return {(words[0] & 0x800000) != 0, y(words[1]), y(words[1] >> 16), y(words[0]),
+                x(words[4]), x(words[6]), x(words[2]), x(words[5]), x(words[7]), x(words[3])};
+    }
+
+    struct EdgeVertex { float x, y; };
+    struct EdgeTriangles {
+        // Two trapezoids, each at most two triangles.
+        std::array<EdgeVertex, 12> vertices{};
+        uint32_t vertexCount = 0;
+    };
+
+    // Rebuild the area the RDP edge walker fills: H against M from YH to YM,
+    // then H against L from YM to YL. Each edge keeps its own coefficients, so
+    // neighbours that share an edge share its line even when their implied
+    // corners disagree (slopes rounded by the microcode). Extrapolating
+    // corners along H instead opens sub-pixel seams that the RDP's
+    // multi-sample coverage hides but GPU centre sampling exposes.
+    inline EdgeTriangles edgeTriangles(const TriangleEdges& e) {
+        EdgeTriangles result;
+        if (!(e.yl > e.yh)) return result;
+        const double side = e.leftMajor ? 1.0 : -1.0;
+        auto trapezoid = [&](double y0, double y1, auto minorX) {
+            if (!(y1 > y0)) return;
+            // Span width is linear in y. The RDP draws nothing where the
+            // minor edge has crossed to the wrong side of H.
+            const double w0 = side * (minorX(y0) - e.majorX(y0));
+            const double w1 = side * (minorX(y1) - e.majorX(y1));
+            if (!(w0 > 0) && !(w1 > 0)) return;
+            if (w0 < 0) y0 += (y1 - y0) * w0 / (w0 - w1);
+            else if (w1 < 0) y1 = y0 + (y1 - y0) * w0 / (w0 - w1);
+            const EdgeVertex a{float(e.majorX(y0)), float(y0)}, b{float(minorX(y0)), float(y0)};
+            const EdgeVertex c{float(minorX(y1)), float(y1)}, d{float(e.majorX(y1)), float(y1)};
+            for (const auto& v : {a, b, c, a, c, d}) result.vertices[result.vertexCount++] = v;
+        };
+        const double ym = std::clamp(e.ym, e.yh, e.yl);
+        trapezoid(e.yh, ym, [&](double y) { return e.middleX(y); });
+        trapezoid(ym, e.yl, [&](double y) { return e.lowX(y); });
+        return result;
+    }
+}
