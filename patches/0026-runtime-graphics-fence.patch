@@ -201,2 +206,15 @@
 
+bool ultramodern::wait_for_submitted_graphics(uint8_t* live_rdram) {
+    assert(ultramodern::is_game_thread());
+    if (exited.load()) return false;
+    auto done = std::make_shared<moodycamel::LightweightSemaphore>();
+    if (!events_context.action_queue.enqueue(GraphicsFence{done})) return false;
+    while (!done->tryWait()) {
+        if (exited.load()) return false;
+        ultramodern::wait_for_external_message_timed(live_rdram, 0);
+        if (done->wait(1000)) break;
+    }
+    return true;
+}
