+#pragma once
+#include <cstdint>
+
+namespace ultramodern {
+// Optional graphics-thread callbacks bracket presentation and report physical VI
+// origin in bytes. vi_tick runs on the retrace thread. Callbacks must outlive
+// queued actions. Disabling restores retrace-driven presentation.
+struct SwapPresentation {
+    void (*bind)(bool) = nullptr;
+    void (*presented)(uint32_t) = nullptr;
+    void (*vi_tick)() = nullptr;
+};
+void set_swap_presentation(bool enabled, SwapPresentation callbacks = {});
+}
