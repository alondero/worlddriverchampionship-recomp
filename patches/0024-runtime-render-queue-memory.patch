diff --git a/librecomp/include/librecomp/queue_memory.hpp b/librecomp/include/librecomp/queue_memory.hpp
new file mode 100644
--- /dev/null
+++ b/librecomp/include/librecomp/queue_memory.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace recomp {
+// Scope for sends, jams and receives issued from a word-swapped KSEG0 image.
+// The live scheduler owns the queues. Receive results belong to the image.
+// Both buffers must cover bytes and remain valid across blocking calls.
+class ScopedQueueMemory {
+public:
+    ScopedQueueMemory(uint8_t* image, uint8_t* live, std::size_t bytes);
+    ~ScopedQueueMemory();
+    ScopedQueueMemory(const ScopedQueueMemory&) = delete;
+    ScopedQueueMemory& operator=(const ScopedQueueMemory&) = delete;
+
+    static const ScopedQueueMemory* for_image(const uint8_t* memory);
+    bool contains(uint32_t address, std::size_t width) const;
+    uint8_t* scheduler_memory() const { return live_; }
+private:
+    const ScopedQueueMemory* previous_;
+    uint8_t* image_;
+    uint8_t* live_;
+    std::size_t bytes_;
+};
+}
diff --git a/librecomp/src/ultra_translation.cpp b/librecomp/src/ultra_translation.cpp
--- a/librecomp/src/ultra_translation.cpp
+++ b/librecomp/src/ultra_translation.cpp
@@ -3,4 +3,26 @@
 #include <ultramodern/ultramodern.hpp>
 #include "recomp.h"
+#include "librecomp/queue_memory.hpp"
+
+namespace {
+thread_local const recomp::ScopedQueueMemory* queue_scope = nullptr;
+}
+namespace recomp {
+ScopedQueueMemory::ScopedQueueMemory(uint8_t* image, uint8_t* live, std::size_t bytes)
+    : previous_(queue_scope), image_(image), live_(live), bytes_(bytes) {
+    queue_scope = this;
+}
+ScopedQueueMemory::~ScopedQueueMemory() { queue_scope = previous_; }
+const ScopedQueueMemory* ScopedQueueMemory::for_image(const uint8_t* memory) {
+    if (!queue_scope || !memory || queue_scope->image_ != memory || queue_scope->live_ == memory)
+        return nullptr;
+    return queue_scope;
+}
+bool ScopedQueueMemory::contains(uint32_t address, std::size_t width) const {
+    return live_ && address >= 0x80000000u && !(address & 3) &&
+           width <= bytes_ && address - 0x80000000u <= bytes_ - width;
+}
+}
+
 
 extern "C" void osInitialize_recomp(uint8_t * rdram, recomp_context * ctx) {
